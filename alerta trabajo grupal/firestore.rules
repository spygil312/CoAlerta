rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function authorizedAdmin() {
      return signedIn()
        && request.auth.token.email == 'mailig.lebam@gmail.com'
        && activeUser();
    }

    function administratorAccount() {
      return authorizedAdmin()
        && profile(request.auth.uid).rol in ['administrador', 'admin'];
    }

    function validAdminAccountPromotion(uid) {
      return self(uid)
        && request.auth.token.email == 'mailig.lebam@gmail.com'
        && resource.data.correo == request.auth.token.email
        && resource.data.activo == true
        && resource.data.rol == 'coordinador'
        && request.resource.data.rol == 'administrador'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol']);
    }

    function validUnitId(unitId) {
      return unitId.matches('^Unidad-(0[1-9]|10)$');
    }

    function validUnitCreate(unitId) {
      let data = request.resource.data;
      return administratorAccount()
        && validUnitId(unitId)
        && data.keys().hasOnly(['estado', 'asignadaA'])
        && data.keys().hasAll(['estado', 'asignadaA'])
        && data.estado in ['disponible', 'ocupada']
        && (data.estado == 'disponible'
          && data.asignadaA == null
          || data.estado == 'ocupada'
          && data.asignadaA is string
          && exists(/databases/$(database)/documents/usuarios/$(data.asignadaA))
          && get(/databases/$(database)/documents/usuarios/$(data.asignadaA)).data.rol == 'seguridad'
          && get(/databases/$(database)/documents/usuarios/$(data.asignadaA)).data.activo == true
          && get(/databases/$(database)/documents/usuarios/$(data.asignadaA)).data.estadoSolicitudRol == 'aprobada'
          && get(/databases/$(database)/documents/usuarios/$(data.asignadaA)).data.patrullaId == unitId);
    }

    function validUnitAssignment(unitId) {
      let userId = request.resource.data.asignadaA;
      let userPath = /databases/$(database)/documents/usuarios/$(userId is string ? userId : 'no-assignment');
      let assignedProfile = getAfter(userPath).data;
      let releasingUserId = resource.data.get('asignadaA', null);
      let releasingUserPath = /databases/$(database)/documents/usuarios/$(releasingUserId is string ? releasingUserId : 'no-assignment');
      let releasingProfile = getAfter(
        releasingUserPath
      ).data;
      return administratorAccount()
        && validUnitId(unitId)
        && request.resource.data.keys().hasOnly(['estado', 'asignadaA'])
        && request.resource.data.keys().hasAll(['estado', 'asignadaA'])
        && (
          resource.data.estado == 'disponible'
          && resource.data.asignadaA == null
          && request.resource.data.estado == 'ocupada'
          && userId is string
          && existsAfter(userPath)
          && assignedProfile.rol == 'seguridad'
          && assignedProfile.activo == true
          && assignedProfile.estadoSolicitudRol == 'aprobada'
          && assignedProfile.patrullaId == unitId
          && assignedProfile.codigoPatrulla == unitId
          && assignedProfile.fechaAsignacion == request.time
          || resource.data.estado == 'ocupada'
          && releasingUserId is string
          && request.resource.data.estado == 'disponible'
          && request.resource.data.asignadaA == null
          && existsAfter(
            /databases/$(database)/documents/usuarios/$(releasingUserId)
          )
          && releasingProfile.patrullaId != unitId
        );
    }

    function validAdminPatrolAssignment(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let unitId = request.resource.data.patrullaId;
      let previousUnitId = resource.data.get('patrullaId', '');
      let unitPath = /databases/$(database)/documents/unidades/$(unitId);
      let previousUnitPath = /databases/$(database)/documents/unidades/$(previousUnitId == null || previousUnitId == '' ? 'no-assignment' : previousUnitId);
      let previousUnitMustBeReleased = previousUnitId in [null, '']
        || !exists(previousUnitPath)
        || existsAfter(previousUnitPath)
        && getAfter(previousUnitPath).data.estado == 'disponible'
        && getAfter(previousUnitPath).data.asignadaA == null;
      return administratorAccount()
        && resource.data.rol == 'seguridad'
        && resource.data.activo == true
        && resource.data.estadoSolicitudRol == 'aprobada'
        && validUnitId(unitId)
        && changed.hasOnly(['patrullaId', 'codigoPatrulla', 'fechaAsignacion'])
        && changed.hasAll(['patrullaId', 'fechaAsignacion'])
        && request.resource.data.codigoPatrulla == unitId
        && request.resource.data.fechaAsignacion == request.time
        && existsAfter(unitPath)
        && getAfter(unitPath).data.estado == 'ocupada'
        && getAfter(unitPath).data.asignadaA == uid
        && (previousUnitId in [null, '']
          || previousUnitId == unitId
          || previousUnitMustBeReleased);
    }

    function validRoleRequestDecision() {
      let approvedCoordinator = request.resource.data.rol == 'coordinador'
        && request.resource.data.estadoSolicitudRol == 'aprobada';
      return authorizedAdmin()
        && resource.data.rol == 'vecino'
        && resource.data.estadoSolicitudRol == 'pendiente'
        && resource.data.rolSolicitud in ['coordinador', 'seguridad']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rol', 'estadoSolicitudRol', 'comunidadId'])
        && request.resource.data.rolSolicitud == resource.data.rolSolicitud
        && request.resource.data.estadoSolicitudRol in ['aprobada', 'rechazada']
        && request.resource.data.rol == (
          request.resource.data.estadoSolicitudRol == 'aprobada'
            ? resource.data.rolSolicitud
            : 'vecino'
        )
        && (approvedCoordinator
          ? request.resource.data.comunidadId == 'comunidad_general_1'
          : request.resource.data.get('comunidadId', null)
            == resource.data.get('comunidadId', null));
    }

    function validCoordinatorCommunityRepair(uid) {
      return self(uid)
        && activeUser()
        && resource.data.rol == 'coordinador'
        && (resource.data.get('comunidadId', null) == null
          || resource.data.comunidadId == '')
        && request.resource.data.comunidadId == 'comunidad_general_1'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['comunidadId']);
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && profile(request.auth.uid).activo == true;
    }

    function staff() {
      return activeUser()
        && (
          profile(request.auth.uid).rol in ['coordinador', 'agente', 'seguridad', 'administrador', 'admin']
          || activeDelegation()
        );
    }

    function activeDelegation() {
      return activeUser()
        && profile(request.auth.uid).comunidadId is string
        && exists(/databases/$(database)/documents/delegaciones/$(profile(request.auth.uid).comunidadId))
        && get(/databases/$(database)/documents/delegaciones/$(profile(request.auth.uid).comunidadId)).data.suplenteUid == request.auth.uid
        && get(/databases/$(database)/documents/delegaciones/$(profile(request.auth.uid).comunidadId)).data.inicio <= request.time
        && get(/databases/$(database)/documents/delegaciones/$(profile(request.auth.uid).comunidadId)).data.fin >= request.time;
    }

    function sameCommunity(comunidadId) {
      return activeUser() && profile(request.auth.uid).comunidadId == comunidadId;
    }

    function coordinatorFor(comunidadId) {
      return activeUser()
        && profile(request.auth.uid).rol == 'coordinador'
        && profile(request.auth.uid).comunidadId == comunidadId;
    }

    function operator() {
      return activeUser()
        && profile(request.auth.uid).rol in ['agente', 'seguridad', 'administrador', 'admin'];
    }

    function adminOperator() {
      return activeUser()
        && profile(request.auth.uid).rol in ['administrador', 'admin'];
    }

    function validInvitationId(invitationId) {
      return invitationId.matches('^[A-F0-9]{24}$');
    }

    function validJoinProfile(uid) {
      let invitationId = request.resource.data.invitacionId;
      let invitation = getAfter(
        /databases/$(database)/documents/invitaciones/$(invitationId)
      ).data;
      return self(uid)
        && activeUser()
        && resource.data.rol in ['vecino', 'seguridad']
        && resource.data.get('comunidadId', null) in [null, '']
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.comunidadId is string
        && request.resource.data.comunidadId.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['comunidadId', 'invitacionId'])
        && validInvitationId(invitationId)
        && invitation.activo == false
        && invitation.usadoPor == uid
        && invitation.usadoAt == request.time
        && invitation.comunidadId == request.resource.data.comunidadId;
    }

    function validInvitationCreate(invitationId) {
      let data = request.resource.data;
      return validInvitationId(invitationId)
        && activeUser()
        && profile(request.auth.uid).rol == 'coordinador'
        && profile(request.auth.uid).comunidadId == data.comunidadId
        && data.keys().hasOnly(['comunidadId', 'creadoPor', 'activo', 'fechaCreacion'])
        && data.keys().hasAll(['comunidadId', 'creadoPor', 'activo', 'fechaCreacion'])
        && data.comunidadId is string
        && data.creadoPor == request.auth.uid
        && data.activo == true
        && data.fechaCreacion == request.time;
    }

    function validInvitationUse(invitationId) {
      let data = request.resource.data;
      let memberPath = /databases/$(database)/documents/comunidades/$(resource.data.comunidadId)/miembros/$(request.auth.uid);
      return signedIn()
        && activeUser()
        && profile(request.auth.uid).rol in ['vecino', 'seguridad']
        && profile(request.auth.uid).get('comunidadId', null) in [null, '']
        && resource.data.activo == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activo', 'usadoPor', 'usadoAt'])
        && data.activo == false
        && data.usadoPor == request.auth.uid
        && data.usadoAt == request.time
        && existsAfter(memberPath)
        && getAfter(memberPath).data.invitacionId == invitationId
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.comunidadId == resource.data.comunidadId;
    }

    function validMemberJoin(comunidadId, uid) {
      let invitationId = request.resource.data.invitacionId;
      let invitation = getAfter(
        /databases/$(database)/documents/invitaciones/$(invitationId)
      ).data;
      return self(uid)
        && activeUser()
        && profile(uid).rol in ['vecino', 'seguridad']
        && profile(uid).get('comunidadId', null) in [null, '']
        && request.resource.data.keys().hasOnly([
          'nombre',
          'telefono',
          'rol',
          'estado',
          'fechaIngreso',
          'invitacionId',
          'ubicacionCompartida'
        ])
        && request.resource.data.keys().hasAll([
          'nombre',
          'telefono',
          'rol',
          'estado',
          'fechaIngreso',
          'invitacionId',
          'ubicacionCompartida'
        ])
        && request.resource.data.nombre == profile(uid).nombre
        && request.resource.data.telefono == profile(uid).telefono
        && request.resource.data.rol == profile(uid).rol
        && request.resource.data.rol in ['vecino', 'seguridad']
        && request.resource.data.estado == 'Activo'
        && request.resource.data.fechaIngreso == request.time
        && request.resource.data.ubicacionCompartida == false
        && validInvitationId(invitationId)
        && invitation.activo == false
        && invitation.usadoPor == uid
        && invitation.usadoAt == request.time
        && invitation.comunidadId == comunidadId
        && getAfter(
          /databases/$(database)/documents/usuarios/$(uid)
        ).data.comunidadId == comunidadId;
    }

    function validIncidentCommunitySync() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let reporters = resource.data.get('reporterUids', []);
      return activeUser()
        && profile(request.auth.uid).rol in ['vecino', 'seguridad', 'coordinador']
        && profile(request.auth.uid).comunidadId is string
        && profile(request.auth.uid).comunidadId.size() > 0
        && request.auth.uid in reporters
        && resource.data.get('comunidadId', null) in [null, '']
        && request.resource.data.comunidadId == profile(request.auth.uid).comunidadId
        && changed.hasOnly(['comunidadId', 'ultimaActualizacion'])
        && request.resource.data.ultimaActualizacion == request.time;
    }

    function validPublicAlertCommunitySync(alertId) {
      let incidentPath = /databases/$(database)/documents/incidentes/$(alertId);
      let incident = getAfter(incidentPath).data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let reporters = incident.get('reporterUids', []);
      return activeUser()
        && existsAfter(incidentPath)
        && profile(request.auth.uid).rol in ['vecino', 'seguridad', 'coordinador']
        && profile(request.auth.uid).comunidadId is string
        && profile(request.auth.uid).comunidadId == incident.comunidadId
        && request.auth.uid in reporters
        && resource.data.get('comunidadId', null) in [null, '']
        && changed.hasOnly(['comunidadId', 'ultimaActualizacion'])
        && request.resource.data.comunidadId == incident.comunidadId
        && request.resource.data.ultimaActualizacion == request.time
        && incident.ultimaActualizacion == request.time;
    }

    function validCommunityMemberLocationUpdate(comunidadId, uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let sharing = request.resource.data.ubicacionCompartida == true;
      return self(uid)
        && activeUser()
        && profile(uid).rol == 'seguridad'
        && profile(uid).comunidadId == comunidadId
        && resource.data.rol == 'seguridad'
        && resource.data.estado == 'Activo'
        && changed.hasOnly([
          'latitud',
          'longitud',
          'precisionMetros',
          'ubicacionCompartida',
          'ubicacionActualizadaAt'
        ])
        && request.resource.data.ubicacionActualizadaAt == request.time
        && (sharing
          ? request.resource.data.latitud is number
            && request.resource.data.latitud >= -90
            && request.resource.data.latitud <= 90
            && request.resource.data.longitud is number
            && request.resource.data.longitud >= -180
            && request.resource.data.longitud <= 180
            && request.resource.data.precisionMetros is number
            && request.resource.data.precisionMetros > 0
            && request.resource.data.precisionMetros <= 100000
          : request.resource.data.ubicacionCompartida == false
            && request.resource.data.latitud == null
            && request.resource.data.longitud == null
            && request.resource.data.precisionMetros == null);
    }

    function validCommunityMemberProfileUpdate(comunidadId, uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return self(uid)
        && activeUser()
        && profile(uid).rol in ['vecino', 'seguridad']
        && profile(uid).comunidadId == comunidadId
        && resource.data.rol == profile(uid).rol
        && resource.data.estado == 'Activo'
        && changed.hasOnly(['nombre', 'telefono'])
        && changed.hasAny(['nombre', 'telefono'])
        && request.resource.data.nombre == profile(uid).nombre
        && request.resource.data.telefono == profile(uid).telefono
        && request.resource.data.telefono.matches('^[0-9]{9}$');
    }

    function validOfficialNoticeCreate() {
      let data = request.resource.data;
      let incidentPath = /databases/$(database)/documents/incidentes/$(data.incidenteId);
      let incident = get(incidentPath).data;
      let publisher = coordinatorFor(data.comunidadId) || administratorAccount();
      return publisher
        && exists(incidentPath)
        && data.keys().hasOnly([
          'titulo',
          'mensaje',
          'plantilla',
          'tipoIncidente',
          'incidenteId',
          'resultadoIncidente',
          'autorUid',
          'comunidadId',
          'timestamp'
        ])
        && data.keys().hasAll([
          'titulo',
          'mensaje',
          'plantilla',
          'tipoIncidente',
          'incidenteId',
          'resultadoIncidente',
          'autorUid',
          'comunidadId',
          'timestamp'
        ])
        && data.autorUid == request.auth.uid
        && data.timestamp == request.time
        && incident.comunidadId == data.comunidadId
        && incident.estado == 'Emergencia Concluida'
        && incident.derivadaAt is timestamp
        && incident.resultado == data.resultadoIncidente
        && data.plantilla in [
          'Emergencia canalizada',
          'Sujeto retenido por autoridades',
          'Zona segura',
          'Falsa alarma aclarada por autoridades'
        ]
        && data.tipoIncidente == incident.tipo
        && data.titulo == 'Comunicado oficial · ' + incident.tipo
        && data.mensaje == data.plantilla + '. Resultado de revisión: ' + incident.resultado
        && (incident.resultado == 'Falsa alarma'
          ? data.plantilla == 'Falsa alarma aclarada por autoridades'
          : data.plantilla != 'Falsa alarma aclarada por autoridades');
    }

    function validIncidentUpdate(incidentId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let coordinator = coordinatorFor(resource.data.comunidadId);
      let assignedOperator = operator()
        && (adminOperator()
          || profile(request.auth.uid).comunidadId == resource.data.comunidadId
          && profile(request.auth.uid).patrullaId == resource.data.patrullaId);
      let dispatchOperator = operator()
        && (adminOperator()
          || profile(request.auth.uid).comunidadId == resource.data.comunidadId
          && profile(request.auth.uid).patrullaId == request.resource.data.patrullaId);
      let dispatchPatrolPath = /databases/$(database)/documents/patrullas/$(request.resource.data.patrullaId);
      let dispatchUnitPath = /databases/$(database)/documents/unidades/$(request.resource.data.patrullaId);
      let closePatrolPath = /databases/$(database)/documents/patrullas/$(resource.data.patrullaId);
      return activeUser()
        && request.resource.data.id == resource.data.id
        && request.resource.data.comunidadId == resource.data.comunidadId
        && request.resource.data.ultimaActualizacion == request.time
        && (
          coordinator
          && resource.data.estado == 'Recibido en servidor'
          && request.resource.data.estado == 'Derivada a Central'
          && changed.hasOnly(['estado', 'derivadaAt', 'ultimaActualizacion'])
          && request.resource.data.derivadaAt == request.time
          || coordinator
          && resource.data.estado in [
            'Recibido en servidor',
            'En revisión',
            'Derivada a Central',
            'Auxilio en camino',
            'Agentes en sitio'
          ]
          && request.resource.data.estado == 'Descartada'
          && request.resource.data.motivoDescarte in [
            'Prueba de usuario',
            'Falsa alarma comprobada',
            'Duplicado'
          ]
          && request.resource.data.resueltoPorUid == request.auth.uid
          && changed.hasOnly(['estado', 'motivoDescarte', 'closedAt', 'ultimaActualizacion', 'resueltoPorUid'])
          && request.resource.data.closedAt == request.time
          || dispatchOperator
          && resource.data.estado == 'Derivada a Central'
          && request.resource.data.estado == 'Auxilio en camino'
          && (adminOperator()
            || request.resource.data.patrullaId == profile(request.auth.uid).patrullaId)
          && exists(dispatchPatrolPath)
          && validUnitId(request.resource.data.patrullaId)
          && exists(dispatchUnitPath)
          && get(dispatchUnitPath).data.estado == 'ocupada'
          && get(dispatchUnitPath).data.asignadaA == request.auth.uid
          && profile(request.auth.uid).ultimaUbicacion.timestamp is timestamp
          && profile(request.auth.uid).ultimaUbicacion.timestamp <= request.time
          && profile(request.auth.uid).ultimaUbicacion.timestamp >= request.time - duration.value(5, 'm')
          && get(dispatchPatrolPath).data.estado != 'Fuera de servicio'
          && get(dispatchPatrolPath).data.updatedAt is timestamp
          && get(dispatchPatrolPath).data.updatedAt <= request.time
          && get(dispatchPatrolPath).data.updatedAt >= request.time - duration.value(5, 'm')
          && existsAfter(dispatchPatrolPath)
          && getAfter(dispatchPatrolPath).data.estado == 'Despachado'
          && getAfter(dispatchPatrolPath).data.incidenteId == incidentId
          && getAfter(dispatchPatrolPath).data.comunidadId == resource.data.comunidadId
          && request.resource.data.unidad == getAfter(dispatchPatrolPath).data.codigo
          && changed.hasOnly([
            'estado',
            'unidad',
            'patrullaId',
            'vehiculo',
            'etaMinutos',
            'despachoAt',
            'ultimaActualizacion'
          ])
          && request.resource.data.unidad is string
          && request.resource.data.vehiculo is string
          && request.resource.data.etaMinutos is int
          && request.resource.data.etaMinutos >= 1
          && request.resource.data.etaMinutos <= 300
          && request.resource.data.despachoAt == request.time
          || assignedOperator
          && resource.data.estado == 'Auxilio en camino'
          && request.resource.data.estado == 'Agentes en sitio'
          && existsAfter(closePatrolPath)
          && getAfter(closePatrolPath).data.estado == 'En sitio'
          && getAfter(closePatrolPath).data.incidenteId == incidentId
          && changed.hasOnly(['estado', 'enSitioAt', 'ultimaActualizacion'])
          && request.resource.data.enSitioAt == request.time
          || assignedOperator
          && resource.data.estado == 'Agentes en sitio'
          && request.resource.data.estado == 'Emergencia Concluida'
          && request.resource.data.resultado in [
            'Intervención preventiva',
            'Sujeto intervenido',
            'Falsa alarma',
            'Persona detenida',
            'Sin novedad'
          ]
          && existsAfter(closePatrolPath)
          && getAfter(closePatrolPath).data.estado == 'Disponible'
          && getAfter(closePatrolPath).data.incidenteId == null
          && request.resource.data.resueltoPorUid == request.auth.uid
          && changed.hasOnly(['estado', 'resultado', 'closedAt', 'ultimaActualizacion', 'resueltoPorUid'])
          && request.resource.data.closedAt == request.time
        );
    }

    function validPublicAlertUpdate(alertId) {
      let incidentPath = /databases/$(database)/documents/incidentes/$(alertId);
      let incident = getAfter(incidentPath).data;
      return validPublicAlertCommunitySync(alertId)
        || activeUser()
        && existsAfter(incidentPath)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tipo',
          'categoria',
          'latitud',
          'longitud',
          'timestamp',
          'estado',
          'prioridad',
          'reportes',
          'ultimaActualizacion',
          'comunidadId'
        ])
        && request.resource.data.tipo == incident.tipo
        && request.resource.data.categoria == incident.categoria
        && request.resource.data.latitud >= incident.latitud - 0.00051
        && request.resource.data.latitud <= incident.latitud + 0.00051
        && request.resource.data.longitud >= incident.longitud - 0.00051
        && request.resource.data.longitud <= incident.longitud + 0.00051
        && request.resource.data.timestamp == incident.timestamp
        && request.resource.data.estado == incident.estado
        && request.resource.data.prioridad == incident.prioridad
        && request.resource.data.reportes == incident.reportes
        && request.resource.data.ultimaActualizacion == request.time
        && incident.ultimaActualizacion == request.time
        && request.resource.data.comunidadId == incident.comunidadId;
    }

    function validProfileUpdate(uid) {
      let data = request.resource.data;
      let contacts = data.get('contactosEmergencia', []);
      let preferences = data.get('preferencias', {});
      return self(uid)
        && activeUser()
        && data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'nombres',
          'apellidos',
          'telefono',
          'correo',
          'direccion',
          'zona',
          'distrito',
          'fotoURL',
          'fotoBase64',
          'photoURL',
          'preferencias',
          'contactosEmergencia'
        ])
        && data.rol == resource.data.rol
        && data.activo == resource.data.activo
        && data.dni == resource.data.dni
        && data.comunidadId == resource.data.comunidadId
        && data.correo == request.auth.token.email
        && data.nombres is string
        && data.nombres.size() > 0
        && data.nombres.size() <= 100
        && data.apellidos is string
        && data.apellidos.size() > 0
        && data.apellidos.size() <= 100
        && data.nombre == data.nombres + ' ' + data.apellidos
        && data.telefono is string
        && data.telefono.matches('^[0-9]{9}$')
        && data.direccion is string
        && data.direccion.size() > 0
        && data.direccion.size() <= 160
        && data.zona == data.direccion
        && data.distrito == data.direccion
        && (!('fotoBase64' in data)
          || data.fotoBase64 is string && data.fotoBase64.size() <= 700000)
        && (!('preferencias' in data)
          || preferences is map
          && preferences.keys().hasOnly(['alertas', 'sonido', 'ubicacion', 'temaOscuro'])
          && (!('alertas' in preferences) || preferences.alertas is bool)
          && (!('sonido' in preferences) || preferences.sonido is bool)
          && (!('ubicacion' in preferences) || preferences.ubicacion is bool)
          && (!('temaOscuro' in preferences) || preferences.temaOscuro is bool))
        && (!('contactosEmergencia' in data)
          || contacts is list
          && contacts.size() <= 2
          && (contacts.size() < 1
            || contacts[0] is map
            && contacts[0].keys().hasOnly(['nombre', 'telefono'])
            && contacts[0].nombre is string
            && contacts[0].nombre.size() > 0
            && contacts[0].nombre.size() <= 80
            && contacts[0].telefono is string
            && contacts[0].telefono.matches('^[0-9]{9}$'))
          && (contacts.size() < 2
            || contacts[1] is map
            && contacts[1].keys().hasOnly(['nombre', 'telefono'])
            && contacts[1].nombre is string
            && contacts[1].nombre.size() > 0
            && contacts[1].nombre.size() <= 80
            && contacts[1].telefono is string
            && contacts[1].telefono.matches('^[0-9]{9}$')));
    }

    function validSelfLocationUpdate(uid) {
      let location = request.resource.data.ultimaUbicacion;
      let unitPath = /databases/$(database)/documents/unidades/$(resource.data.patrullaId);
      return self(uid)
        && activeUser()
        && resource.data.rol in ['seguridad', 'agente']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaUbicacion'])
        && (
          location == null
          && resource.data.rol in ['seguridad', 'agente']
          || location is map
          && location.keys().hasOnly(['latitud', 'longitud', 'timestamp'])
          && location.keys().hasAll(['latitud', 'longitud', 'timestamp'])
          && location.latitud is number
          && location.latitud >= -90
          && location.latitud <= 90
          && location.longitud is number
          && location.longitud >= -180
          && location.longitud <= 180
          && location.timestamp == request.time
          && (
            resource.data.rol == 'seguridad'
            && request.resource.data.comunidadId is string
            && request.resource.data.comunidadId.size() > 0
            || resource.data.rol == 'agente'
            && validUnitId(resource.data.patrullaId)
            && exists(unitPath)
            && get(unitPath).data.estado == 'ocupada'
            && get(unitPath).data.asignadaA == uid
          )
        );
    }

    function validRatingUpdate(uid, alertId) {
      let ratingPath = /databases/$(database)/documents/incidentes/$(alertId)/calificaciones/$(uid);
      let rating = getAfter(ratingPath).data;
      return self(uid)
        && activeUser()
        && existsAfter(ratingPath)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'calificacion',
            'comentarioCalificacion',
            'calificacionOmitida'
        ])
        && (('omitida' in rating && rating.omitida == true)
            && request.resource.data.calificacionOmitida == true
            && !('calificacion' in request.resource.data)
            && !('comentarioCalificacion' in request.resource.data)
            || rating.rating is int
            && request.resource.data.calificacion == rating.rating
            && request.resource.data.get('calificacionOmitida', false) == false
            && request.resource.data.comentarioCalificacion == rating.comment);
    }

    function validRatingCreate(uid, alertId) {
      let data = request.resource.data;
      let incidentPath = /databases/$(database)/documents/incidentes/$(alertId);
      let incident = get(incidentPath).data;
      return self(uid)
        && activeUser()
        && exists(incidentPath)
        && uid in incident.reporterUids
        && incident.estado == 'Emergencia Concluida'
        && data.createdAt == request.time
        && (
            data.keys().hasOnly(['omitida', 'createdAt'])
            && data.keys().hasAll(['omitida', 'createdAt'])
            && data.omitida == true
            || data.keys().hasOnly(['rating', 'comment', 'createdAt'])
            && data.keys().hasAll(['rating', 'comment', 'createdAt'])
            && !('omitida' in data)
            && data.rating is int
            && data.rating >= 1
            && data.rating <= 5
            && (data.comment == null
              || data.comment in ['Llegaron rápido', 'Trato amable', 'Demora en arribo'])
        );
    }

    function validAccountDeactivation(uid) {
      return self(uid)
        && activeUser()
        && resource.data.activo == true
        && request.resource.data.activo == false
        && request.resource.data.desactivadoAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activo', 'desactivadoAt']);
    }

    function validZoneWrite(comunidadId) {
      let data = request.resource.data;
      return coordinatorFor(comunidadId)
        && data.keys().hasOnly([
          'comunidadId',
          'latitud',
          'longitud',
          'radioMetros',
          'updatedBy',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'comunidadId',
          'latitud',
          'longitud',
          'radioMetros',
          'updatedBy',
          'updatedAt'
        ])
        && data.comunidadId == comunidadId
        && data.latitud is number
        && data.latitud >= -90
        && data.latitud <= 90
        && data.longitud is number
        && data.longitud >= -180
        && data.longitud <= 180
        && data.radioMetros is number
        && data.radioMetros >= 100
        && data.radioMetros <= 20000
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validDelegationWrite(comunidadId) {
      let data = request.resource.data;
      let substitutePath = /databases/$(database)/documents/usuarios/$(data.suplenteUid);
      let memberPath = /databases/$(database)/documents/comunidades/$(comunidadId)/miembros/$(data.suplenteUid);
      return coordinatorFor(comunidadId)
        && data.keys().hasOnly([
          'coordinadorUid',
          'suplenteUid',
          'comunidadId',
          'inicio',
          'fin',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'coordinadorUid',
          'suplenteUid',
          'comunidadId',
          'inicio',
          'fin',
          'updatedAt'
        ])
        && data.coordinadorUid == request.auth.uid
        && data.suplenteUid is string
        && data.suplenteUid != request.auth.uid
        && data.comunidadId == comunidadId
        && data.inicio is timestamp
        && data.inicio > request.time
        && data.fin is timestamp
        && data.fin > data.inicio
        && data.fin <= data.inicio + duration.value(31, 'd')
        && data.updatedAt == request.time
        && exists(substitutePath)
        && get(substitutePath).data.activo == true
        && get(substitutePath).data.rol == 'vecino'
        && get(substitutePath).data.comunidadId == comunidadId
        && exists(memberPath)
        && get(memberPath).data.estado == 'Activo'
        && get(memberPath).data.rol == 'vecino';
    }

    function validPatrolLocation(patrolId) {
      let data = request.resource.data;
      let unitPath = /databases/$(database)/documents/unidades/$(patrolId);
      return operator()
        && profile(request.auth.uid).patrullaId == patrolId
        && validUnitId(patrolId)
        && exists(unitPath)
        && get(unitPath).data.estado == 'ocupada'
        && get(unitPath).data.asignadaA == request.auth.uid
        && data.comunidadId == profile(request.auth.uid).comunidadId
        && data.agenteUid == request.auth.uid
        && data.latitud is number
        && data.latitud >= -90
        && data.latitud <= 90
        && data.longitud is number
        && data.longitud >= -180
        && data.longitud <= 180
        && data.precisionMetros is number
        && data.precisionMetros > 0
        && data.precisionMetros <= 100000
        && data.updatedAt == request.time;
    }

    function validPatrolCreate(patrolId) {
      let data = request.resource.data;
      return validPatrolLocation(patrolId)
        && data.keys().hasOnly([
          'codigo',
          'comunidadId',
          'agenteUid',
          'latitud',
          'longitud',
          'precisionMetros',
          'updatedAt',
          'estado'
        ])
        && data.keys().hasAll([
          'codigo',
          'comunidadId',
          'agenteUid',
          'latitud',
          'longitud',
          'precisionMetros',
          'updatedAt',
          'estado'
        ])
        && data.codigo == profile(request.auth.uid).codigoPatrulla
        && data.comunidadId is string
        && data.comunidadId == profile(request.auth.uid).comunidadId
        && data.estado == 'Disponible';
    }

    function validPatrolUpdate(patrolId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let locationUpdate = validPatrolLocation(patrolId)
        && changed.hasOnly([
          'comunidadId',
          'agenteUid',
          'latitud',
          'longitud',
          'precisionMetros',
          'updatedAt'
        ])
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.get('incidenteId', null) == resource.data.get('incidenteId', null)
        && (resource.data.get('comunidadId', null) == null
          || resource.data.comunidadId == request.resource.data.comunidadId)
        && (!('updatedAt' in resource.data)
          || resource.data.updatedAt is timestamp
          && resource.data.updatedAt <= request.time - duration.value(5, 's'));
      return locationUpdate || validPatrolStatusUpdate(patrolId);
    }

    function validPatrolStatusUpdate(patrolId) {
      let existingIncidentId = resource.data.get('incidenteId', null);
      let incidentId = existingIncidentId == null
        ? request.resource.data.get('incidenteId', '')
        : existingIncidentId;
      let incidentPath = /databases/$(database)/documents/incidentes/$(incidentId);
      let incident = getAfter(incidentPath).data;
      let statusUpdate = operator()
        && (adminOperator() || profile(request.auth.uid).patrullaId == patrolId)
        && existsAfter(incidentPath)
        && incident.patrullaId == patrolId
        && incident.comunidadId == resource.data.comunidadId
        && request.resource.data.comunidadId == resource.data.comunidadId
        && (
          request.resource.data.estado == 'Despachado'
          && incident.estado == 'Auxilio en camino'
          && resource.data.estado == 'Disponible'
          && resource.data.get('incidenteId', null) == null
          && request.resource.data.incidenteId == incidentId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'incidenteId', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          || request.resource.data.estado == 'En sitio'
          && incident.estado == 'Agentes en sitio'
          && resource.data.estado == 'Despachado'
          && resource.data.incidenteId == incidentId
          && request.resource.data.incidenteId == incidentId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'incidenteId', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          || request.resource.data.estado == 'Disponible'
          && incident.estado == 'Emergencia Concluida'
          && resource.data.estado == 'En sitio'
          && resource.data.incidenteId == incidentId
          && request.resource.data.incidenteId == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'incidenteId', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
        );
      return statusUpdate;
    }

    function validCommunityAnnouncementCreate(comunidadId) {
      let data = request.resource.data;
      return coordinatorFor(comunidadId)
        && data.keys().hasOnly([
          'titulo',
          'descripcion',
          'autorUid',
          'autorNombre',
          'fecha'
        ])
        && data.keys().hasAll([
          'titulo',
          'descripcion',
          'autorUid',
          'autorNombre',
          'fecha'
        ])
        && data.titulo is string
        && data.titulo.size() > 0
        && data.titulo.size() <= 100
        && data.descripcion is string
        && data.descripcion.size() > 0
        && data.descripcion.size() <= 1000
        && data.autorUid == request.auth.uid
        && data.autorNombre == profile(request.auth.uid).nombre
        && data.fecha == request.time;
    }

    function validCommunityAnnouncementDelete(comunidadId) {
      return coordinatorFor(comunidadId)
        && resource.data.autorUid == request.auth.uid;
    }

    function validRegistrationProfile(uid) {
      let data = request.resource.data;
      return self(uid)
        && data.keys().hasAll([
          'uid',
          'nombres',
          'apellidos',
          'nombre',
          'correo',
          'telefono',
          'dni',
          'direccion',
          'distrito',
          'zona',
          'rol',
          'comunidadId',
          'activo',
          'fechaRegistro'
        ])
        && data.keys().hasOnly([
          'uid',
          'nombres',
          'apellidos',
          'nombre',
          'correo',
          'telefono',
          'dni',
          'direccion',
          'distrito',
          'zona',
          'rol',
          'rolSolicitud',
          'estadoSolicitudRol',
          'comunidadId',
          'activo',
          'fechaRegistro'
        ])
        && data.uid == uid
        && data.correo == request.auth.token.email
        && data.nombres is string
        && data.nombres.size() > 0
        && data.nombres.size() <= 100
        && data.apellidos is string
        && data.apellidos.size() > 0
        && data.apellidos.size() <= 100
        && data.nombre == data.nombres + ' ' + data.apellidos
        && data.telefono is string
        && data.telefono.matches('^[0-9]{9}$')
        && data.dni is string
        && data.dni.matches('^[0-9]{8}$')
        && data.direccion is string
        && data.direccion.size() > 0
        && data.direccion.size() <= 160
        && data.distrito == data.direccion
        && data.zona == data.direccion
        && data.rol == 'vecino'
        && data.comunidadId == null
        && data.activo == true
        && data.fechaRegistro == request.time
        && (
          !('rolSolicitud' in data)
          && !('estadoSolicitudRol' in data)
          || data.rolSolicitud in ['coordinador', 'seguridad']
          && data.estadoSolicitudRol == 'pendiente'
        )
        && getAfter(
          /databases/$(database)/documents/dni_index/$(data.dni)
        ).data.uid == uid;
    }

    function validIncidentCreate(incidentId) {
      let data = request.resource.data;
      let throttle = getAfter(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)/limites/reportes_emergencia
      ).data;
      return data.keys().hasAll([
          'id',
          'tipo',
          'categoria',
          'detalle',
          'latitud',
          'longitud',
          'precisionMetros',
          'prioridad',
          'estado',
          'timestamp',
          'reportes',
          'reporterUids',
          'comunidadId',
          'ultimaActualizacion'
        ])
        && data.keys().hasOnly([
          'id',
          'tipo',
          'categoria',
          'detalle',
          'latitud',
          'longitud',
          'precisionMetros',
          'prioridad',
          'estado',
          'timestamp',
          'reportes',
          'reporterUids',
          'comunidadId',
          'ultimaActualizacion'
        ])
        && data.id == incidentId
        && data.categoria in ['robo', 'sospecha', 'accidente', 'incendio']
        && data.tipo == (
          data.categoria == 'robo' ? 'Robo'
          : data.categoria == 'sospecha' ? 'Sospecha'
          : data.categoria == 'accidente' ? 'Accidente'
          : 'Incendio'
        )
        && data.detalle is string
        && data.detalle.size() <= 300
        && data.latitud is number
        && data.latitud >= -90
        && data.latitud <= 90
        && data.longitud is number
        && data.longitud >= -180
        && data.longitud <= 180
        && data.precisionMetros is number
        && data.precisionMetros > 0
        && data.precisionMetros <= 100000
        && data.prioridad == (data.categoria == 'sospecha' ? 'Media' : 'Alta')
        && data.estado == 'Recibido en servidor'
        && data.timestamp == request.time
        && data.ultimaActualizacion == request.time
        && data.reportes == 1
        && data.reporterUids == [request.auth.uid]
        && data.comunidadId == profile(request.auth.uid).get('comunidadId', null)
        && throttle.uid == request.auth.uid
        && throttle.ultimaAlertaAt == request.time;
    }

    function validPublicAlertCreate(incidentId) {
      let data = request.resource.data;
      let incident = getAfter(
        /databases/$(database)/documents/incidentes/$(incidentId)
      ).data;
      return data.keys().hasAll([
          'tipo',
          'categoria',
          'latitud',
          'longitud',
          'timestamp',
          'estado',
          'prioridad',
          'reportes',
          'ultimaActualizacion',
          'comunidadId'
        ])
        && data.keys().hasOnly([
          'tipo',
          'categoria',
          'latitud',
          'longitud',
          'timestamp',
          'estado',
          'prioridad',
          'reportes',
          'ultimaActualizacion',
          'comunidadId'
        ])
        && data.tipo == incident.tipo
        && data.categoria == incident.categoria
        && data.latitud is number
        && data.latitud >= incident.latitud - 0.00051
        && data.latitud <= incident.latitud + 0.00051
        && data.longitud is number
        && data.longitud >= incident.longitud - 0.00051
        && data.longitud <= incident.longitud + 0.00051
        && data.timestamp == request.time
        && data.estado == incident.estado
        && data.prioridad == incident.prioridad
        && data.reportes == 1
        && data.ultimaActualizacion == request.time
        && data.comunidadId == incident.comunidadId;
    }

    function validOwnAlertCreate(uid, incidentId) {
      let data = request.resource.data;
      let incident = getAfter(
        /databases/$(database)/documents/incidentes/$(incidentId)
      ).data;
      return self(uid)
        && data.keys().hasAll([
          'alertaId',
          'tipo',
          'categoria',
          'latitud',
          'longitud',
          'precisionMetros',
          'timestamp',
          'estado',
          'prioridad',
          'unidad',
          'vehiculo',
          'etaMinutos',
          'motivoDescarte',
          'emisorUid',
          'ultimaActualizacion',
          'detalle'
        ])
        && data.keys().hasOnly([
          'alertaId',
          'tipo',
          'categoria',
          'latitud',
          'longitud',
          'precisionMetros',
          'timestamp',
          'estado',
          'prioridad',
          'unidad',
          'vehiculo',
          'etaMinutos',
          'motivoDescarte',
          'emisorUid',
          'ultimaActualizacion',
          'detalle'
        ])
        && data.alertaId == incidentId
        && data.tipo == incident.tipo
        && data.categoria == incident.categoria
        && data.latitud == incident.latitud
        && data.longitud == incident.longitud
        && data.precisionMetros == incident.precisionMetros
        && data.timestamp == request.time
        && data.estado == incident.estado
        && data.prioridad == incident.prioridad
        && data.unidad == null
        && data.vehiculo == null
        && data.etaMinutos == null
        && data.motivoDescarte == null
        && data.emisorUid == uid
        && data.ultimaActualizacion == request.time
        && data.detalle == incident.detalle;
    }

    match /usuarios/{uid} {
      allow get: if self(uid) || authorizedAdmin();
      allow list: if authorizedAdmin();
      allow create: if validRegistrationProfile(uid);
      allow delete: if false;
      allow update: if validAdminAccountPromotion(uid)
        || validRoleRequestDecision()
        || validProfileUpdate(uid)
        || validSelfLocationUpdate(uid)
        || validAdminPatrolAssignment(uid)
        || validJoinProfile(uid)
        || validAccountDeactivation(uid)
        || validCoordinatorCommunityRepair(uid)
        || self(uid)
        && resource.data.get('dni', '') == ''
        && resource.data.get('rol', 'vecino') == 'vecino'
        && resource.data.get('activo', true) == true
        && validRegistrationProfile(uid);

      match /alertas/{alertaId} {
        allow read: if self(uid);
        allow create: if self(uid)
          && activeUser()
          && validOwnAlertCreate(uid, alertaId);
        allow update: if self(uid)
          && activeUser()
          && validRatingUpdate(uid, alertaId);
        allow delete: if false;
      }

      match /limites/{limiteId} {
        allow get: if self(uid) && limiteId == 'reportes_emergencia';
        allow list, delete: if false;
        allow create: if self(uid)
          && activeUser()
          && limiteId == 'reportes_emergencia'
          && request.resource.data.keys().hasOnly(['uid', 'ultimaAlertaAt'])
          && request.resource.data.keys().hasAll(['uid', 'ultimaAlertaAt'])
          && request.resource.data.uid == uid
          && request.resource.data.ultimaAlertaAt == request.time;
        allow update: if self(uid)
          && activeUser()
          && limiteId == 'reportes_emergencia'
          && resource.data.uid == uid
          && resource.data.ultimaAlertaAt is timestamp
          && resource.data.ultimaAlertaAt <= request.time - duration.value(30, 's')
          && request.resource.data.keys().hasOnly(['uid', 'ultimaAlertaAt'])
          && request.resource.data.keys().hasAll(['uid', 'ultimaAlertaAt'])
          && request.resource.data.uid == uid
          && request.resource.data.ultimaAlertaAt == request.time;
      }

      match /alertas_leidas/{alertaId} {
        allow read: if self(uid);
        allow create: if self(uid)
          && activeUser()
          && request.resource.data.keys().hasOnly(['alertaId', 'readAt'])
          && request.resource.data.keys().hasAll(['alertaId', 'readAt'])
          && request.resource.data.alertaId == alertaId
          && request.resource.data.readAt == request.time
          && exists(/databases/$(database)/documents/alertas_publicas/$(alertaId));
        allow update, delete: if false;
      }

      match /avisos_leidos/{avisoId} {
        allow read: if self(uid);
        allow create: if self(uid)
          && activeUser()
          && request.resource.data.keys().hasOnly(['avisoId', 'readAt'])
          && request.resource.data.keys().hasAll(['avisoId', 'readAt'])
          && request.resource.data.avisoId == avisoId
          && request.resource.data.readAt == request.time
          && exists(/databases/$(database)/documents/avisos_publicos/$(avisoId))
          && get(/databases/$(database)/documents/avisos_publicos/$(avisoId)).data.comunidadId
            == profile(uid).comunidadId;
        allow update, delete: if false;
      }
    }

    match /unidades/{unitId} {
      allow get, list: if administratorAccount();
      allow create: if validUnitCreate(unitId);
      allow update: if validUnitAssignment(unitId);
      allow delete: if false;
    }

    match /invitaciones/{invitacionId} {
      allow get: if signedIn() && validInvitationId(invitacionId);
      allow list: if false;
      allow create: if validInvitationCreate(invitacionId);
      allow update: if validInvitationUse(invitacionId);
      allow delete: if false;
    }

    match /incidentes/{incidenteId} {
      allow read: if staff()
        || activeUser() && request.auth.uid in resource.data.reporterUids;
      allow create: if activeUser() && validIncidentCreate(incidenteId);

      match /calificaciones/{uid} {
        allow get: if self(uid);
        allow list: if false;
        allow create: if validRatingCreate(uid, incidenteId);
        allow update, delete: if false;
      }

      allow update: if validIncidentUpdate(incidenteId) || validIncidentCommunitySync();
      allow delete: if false;
    }

    match /alertas_publicas/{alertaId} {
      allow read: if activeUser();
      allow create: if activeUser() && validPublicAlertCreate(alertaId);
      allow update: if validPublicAlertUpdate(alertaId);
      allow delete: if false;
    }

    match /avisos_publicos/{avisoId} {
      allow read: if activeUser()
        && resource.data.comunidadId == profile(request.auth.uid).comunidadId;
      allow create: if validOfficialNoticeCreate();
      allow update, delete: if false;
    }

    match /auditoria/{eventoId} {
      allow read: if staff();
      allow write: if false;
    }

    match /zonas/{comunidadId} {
      allow read: if sameCommunity(comunidadId);
      allow create, update: if validZoneWrite(comunidadId);
      allow delete: if false;
    }

    match /delegaciones/{delegacionId} {
      allow read: if staff() || activeDelegation();
      allow create, update: if validDelegationWrite(delegacionId);
      allow delete: if false;
    }

    match /patrullas/{patrullaId} {
      allow read: if staff();
      allow create: if validPatrolCreate(patrullaId);
      allow update: if validPatrolUpdate(patrullaId);
      allow delete: if false;
    }

    match /seguridad_usuarios/{uid} {
      allow read, write: if false;
    }

    match /dni_index/{dni} {
      allow read, list, update, delete: if false;
      allow create: if signedIn()
        && dni.matches('^[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.dni == dni;
    }

    match /comunidades/{comunidadId} {
      allow get: if sameCommunity(comunidadId);
      allow list: if false;
      allow create, update, delete: if false;

      match /miembros/{uid} {
        allow get: if sameCommunity(comunidadId)
          || self(uid)
          && activeUser()
          && profile(uid).get('comunidadId', null) in [null, ''];
        allow list: if sameCommunity(comunidadId);
        allow create: if validMemberJoin(comunidadId, uid);
        allow update: if validCommunityMemberLocationUpdate(comunidadId, uid)
          || validCommunityMemberProfileUpdate(comunidadId, uid);
        allow delete: if false;
      }

      match /anuncios/{anuncioId} {
        allow read: if sameCommunity(comunidadId);
        allow create: if validCommunityAnnouncementCreate(comunidadId);
        allow delete: if validCommunityAnnouncementDelete(comunidadId);
        allow update: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
